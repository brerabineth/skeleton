<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>skeleton</AssemblyName>
    <RootNamespace>Skeleton</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TieredPgo>false</TieredPgo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="warden/Verdict.fs" />
    <Compile Include="warden/KeyFile.fs" />
    <Compile Include="warden/Authorized.fs" />
    <Compile Include="warden/SshConfig.fs" />
    <Compile Include="warden/KnownHosts.fs" />
    <Compile Include="warden/Sweep.fs" />
    <Compile Include="warden/Render.fs" />
    <Compile Include="warden/Program.fs" />
  </ItemGroup>

</Project>
